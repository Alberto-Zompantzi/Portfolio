# URL base pública del backend; NEXT_PUBLIC_API_BASE_URL es el nombre fijado
# por ARCHITECTURE.md v1.0 y README.md. Ejemplo local ficticio.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Origen permitido por CORS. Configurar antes de probar el backend.
FRONTEND_ORIGIN=http://localhost:3000

# Variables adicionales documentadas en README.md para desarrollo del backend.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio_dev
DATABASE_USER=portfolio_example
DATABASE_PASSWORD=replace-me

# Los activos de ImageKit se consumen desde URLs públicas en media.ts; el
# frontend no usa claves ni variables de entorno para subir archivos.
